{
  "server": {
    "port": 8080,
    "read_timeout": "60s",
    "write_timeout": "60s",
    "max_header_bytes": 1048576
  },
  "logging": {
    "level": "debug",
    "format": "console",
    "output": "stdout"
  },
  "features": {
    "enable_bitstream": true,
    "enable_batch_process": true,
    "max_batch_size": 100,
    "enable_analysis": true
  },
  "performance": {
    "max_concurrent_requests": 10,
    "request_timeout": "30s",
    "enable_metrics": true
  }
}