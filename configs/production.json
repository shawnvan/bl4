{
  "server": {
    "port": 8080,
    "read_timeout": "30s",
    "write_timeout": "30s",
    "max_header_bytes": 1048576
  },
  "logging": {
    "level": "warn",
    "format": "json",
    "output": "stdout"
  },
  "features": {
    "enable_bitstream": false,
    "enable_batch_process": true,
    "max_batch_size": 1000,
    "enable_analysis": false
  },
  "performance": {
    "max_concurrent_requests": 1000,
    "request_timeout": "5s",
    "enable_metrics": true
  }
}