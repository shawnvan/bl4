package handlers

import (
	"fmt"
	"net/http"
	"os"
	"strings"

	"github.com/gin-gonic/gin"
	"github.com/shawnvan/bl4/internal/codec/base85"
	"github.com/shawnvan/bl4/internal/codec/serial"
	"github.com/shawnvan/bl4/internal/codec/token"
	"github.com/shawnvan/bl4/pkg/logger"
)

// ReferenceDecodeHandler handles decode requests in reference project format
type ReferenceDecodeHandler struct{}

// NewReferenceDecodeHandler creates a new reference decode handler
func NewReferenceDecodeHandler() *ReferenceDecodeHandler {
	return &ReferenceDecodeHandler{}
}

// HandleDeserialize handles POST /api/v1/deserialize requests (reference format)
func (h *ReferenceDecodeHandler) HandleDeserialize(c *gin.Context) {
	var jsonReq struct {
		SerialB85 string `json:"serial_b85"`
	}
	if err := c.ShouldBindJSON(&jsonReq); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid JSON"})
		return
	}

	fmt.Fprintln(os.Stderr, "# Deserialize:")
	fmt.Fprintln(os.Stderr, " - From: ", jsonReq.SerialB85)

	// Decode using base85 (reference implementation)
	decoder := base85.NewDecoder()
	data, err := decoder.Decode(jsonReq.SerialB85)
	if err != nil {
		fmt.Fprintln(os.Stderr, "Failed to deserialize:", jsonReq.SerialB85, "=>", err.Error())
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Deserialize using serial codec (reference implementation)
	deserializer := serial.NewDeserializer()
	result, err := deserializer.DeserializeItem(jsonReq.SerialB85)
	if err != nil {
		fmt.Fprintln(os.Stderr, "Failed to deserialize:", jsonReq.SerialB85, "=>", err.Error())
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	tokenStream := result.TokenStream
	bits := result.BitstreamInfo.Data

	fmt.Fprintln(os.Stderr, " - To:   ", tokenStream.String())
	fmt.Fprintln(os.Stderr, " - Infos:", h.additionalDataFunc(tokenStream))

	// Return in reference format
	c.JSON(http.StatusOK, gin.H{
		"deserialized":    tokenStream.String(),
		"additional_data": h.additionalDataFunc(tokenStream),
		"bitstream":       bits,
	})
}

// additionalDataFunc generates additional data like the reference project
func (h *ReferenceDecodeHandler) additionalDataFunc(tokenStream *token.TokenStream) string {
	additionalDataArr := make([]string, 0, 5)

	// Try to extract level (first VARINT)
	varInts := tokenStream.GetTokensByType(3) // TokenVARINT = 3
	if len(varInts) > 0 {
		if level, ok := varInts[0].Value.(uint64); ok {
			additionalDataArr = append(additionalDataArr, "L"+fmt.Sprint(level))
		}
	}

	// Try to extract type and manufacturer (next two VARINTs)
	if len(varInts) > 2 {
		if itemType, ok := varInts[1].Value.(uint64); ok {
			additionalDataArr = append(additionalDataArr, fmt.Sprintf("T%d", itemType))
		}
		if manufacturer, ok := varInts[2].Value.(uint64); ok {
			additionalDataArr = append(additionalDataArr, fmt.Sprintf("M%d", manufacturer))
		}
	}

	// Add parts information
	partTokens := tokenStream.GetTokensByType(4) // TokenPART = 4
	if len(partTokens) > 0 {
		additionalDataArr = append(additionalDataArr, fmt.Sprintf("%d parts", len(partTokens)))
	}

	if len(additionalDataArr) > 0 {
		return strings.Join(additionalDataArr, " ")
	}
	return ""
}

// HandleReserialize handles POST /api/v1/reserialize requests (reference format)
func (h *ReferenceDecodeHandler) HandleReserialize(c *gin.Context) {
	var jsonReq struct {
		Deserialized string `json:"deserialized"`
	}
	if err := c.ShouldBindJSON(&jsonReq); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid JSON"})
		return
	}

	// Clean the reserialized data
	{
		// Add a terminator if missing
		if !strings.HasSuffix(jsonReq.Deserialized, "|") {
			jsonReq.Deserialized = jsonReq.Deserialized + "|"
		}

		// If more than two terminators, keep only the first two
		for len(jsonReq.Deserialized) >= 2 && jsonReq.Deserialized[len(jsonReq.Deserialized)-1] == '|' && jsonReq.Deserialized[len(jsonReq.Deserialized)-2] == '|' {
			jsonReq.Deserialized = jsonReq.Deserialized[:len(jsonReq.Deserialized)-1]
		}
	}

	fmt.Fprintln(os.Stderr, "# Reserialize:")
	fmt.Fprintln(os.Stderr, " - From: ", jsonReq.Deserialized)

	// Create token stream from deserialized string
	deserializer := serial.NewDeserializer()
	tokenStream, err := deserializer.FromString(jsonReq.Deserialized)
	if err != nil {
		fmt.Fprintln(os.Stderr, "Failed to import:", jsonReq.Deserialized, "=>", err.Error())
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Serialize back to bytes
	data, err := deserializer.Serialize(tokenStream)
	if err != nil {
		fmt.Fprintln(os.Stderr, "Failed to serialize:", jsonReq.Deserialized, "=>", err.Error())
		c.JSON(http.StatusBadRequest, gin.H{"error": "failed to serialize data"})
		return
	}

	// Encode back to base85
	b85Serial := base85.Encode(data)

	// Re-decode to verify and get bitstream
	redecodedTokenStream, bits, err := deserializer.Deserialize(data)
	if err != nil {
		fmt.Fprintln(os.Stderr, "Failed to re-deserialize:", b85Serial, "=>", err.Error())
		c.JSON(http.StatusBadRequest, gin.H{"error": "failed to re-deserialize data"})
		return
	}

	fmt.Fprintln(os.Stderr, " - To:   ", b85Serial)
	fmt.Fprintln(os.Stderr, " - Infos:", h.additionalDataFunc(redecodedTokenStream))

	c.JSON(http.StatusOK, gin.H{
		"serial_b85":      b85Serial,
		"additional_data": h.additionalDataFunc(redecodedTokenStream),
		"bitstream":       bits,
	})
}